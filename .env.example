# LedgerGuard AI — local development configuration.
# Copy to .env (never commit .env). Values below are DEV-ONLY defaults for the
# local docker-compose stack; they are not secrets and must never be reused in
# any hosted environment.

# --- Application ---------------------------------------------------------
LG_ENV=local
LG_LOG_LEVEL=INFO
# json | console
LG_LOG_FORMAT=console
LG_SERVICE_NAME=ledgerguard-api

# Host-side connection strings (the API runs on the host during development).
# Use 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 ::1 first and
# costs ~2 s per new connection because compose publishes on IPv4 only (ADR-009).
# Runtime role (least privilege: no DDL, audit_events is INSERT/SELECT only).
LG_DATABASE_URL=postgresql+asyncpg://ledgerguard_app:ledgerguard_app_dev@127.0.0.1:55432/ledgerguard
# Schema owner: migrations and admin scripts only.
LG_MIGRATION_DATABASE_URL=postgresql+asyncpg://ledgerguard:ledgerguard_dev@127.0.0.1:55432/ledgerguard
LG_REDIS_URL=redis://127.0.0.1:6379/0
LG_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092

# OpenTelemetry (OTLP/HTTP to the local collector). Set false to disable export.
LG_OTEL_ENABLED=true
LG_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# --- docker-compose ------------------------------------------------------
POSTGRES_USER=ledgerguard
POSTGRES_PASSWORD=ledgerguard_dev
POSTGRES_DB=ledgerguard
POSTGRES_APP_PASSWORD=ledgerguard_app_dev
# 5432 is often taken by a host Postgres; the container is published on 55432.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=6379
REDPANDA_KAFKA_HOST_PORT=19092
REDPANDA_CONSOLE_HOST_PORT=8080
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ledgerguard_dev

# --- Later milestones (not used in M0) -------------------------------------
# AGENTROUTER_API_KEY=            # M4 — keep only in .env, never commit
# AGENTROUTER_BASE_URL=
# SUPABASE_JWT_SECRET=            # M5
